{
  "name": "@finsilabs/pulse",
  "version": "0.1.0",
  "description": "Read-only Meta and Google Ads budget recommendations over MCP, on your own accounts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pulse": "dist/index.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/core/index.js",
    "./server": "./dist/server.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "fixtures/accounts",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node scripts/test.mjs",
    "start": "node dist/index.js",
    "check": "bash scripts/check.sh",
    "smoke": "tsx src/index.ts smoke",
    "fixtures": "tsx src/fixtures/generate.ts",
    "examples": "node scripts/examples.mjs",
    "format": "prettier --write src scripts package.json tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/finsilabs/pulse.git"
  },
  "types": "dist/core/index.d.ts"
}
